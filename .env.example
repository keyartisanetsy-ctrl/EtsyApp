# ---------------------------------------------------------------------------
# Etsy Command Center - copy to .env and fill in.
# Everything here can also be set in the app's Settings screen, which stores
# secrets encrypted in the local database instead of in plain text.
# ---------------------------------------------------------------------------

# --- Etsy app credentials (etsy.com/developers/your-apps) ------------------
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
# Must match the callback URL registered on your Etsy app exactly. Use
# "localhost", not "127.0.0.1" -- Etsy's own app dashboard rejects an
# IP-literal callback URL ("IP addresses are not allowed"), so an IP here
# would leave a shop connection this app cannot actually register with Etsy.
# "localhost" also isn't tied to any one machine, so the same registered
# value keeps working if this app ever moves to a different computer or VDS.
ETSY_REDIRECT_URI=http://localhost:4317/api/auth/callback

# --- Server ----------------------------------------------------------------
PORT=4317
HOST=127.0.0.1
LOG_LEVEL=info
# Set a password only if you expose this beyond localhost.
APP_PASSWORD=
# Set to 1 to have "npm start" also open a temporary public link (a Cloudflare
# Tunnel) to this same running app, so it can be opened from another computer.
# APP_PASSWORD is generated automatically if left blank when this is on --
# never expose the app without one. The link changes every restart; it is
# printed in the terminal window each time the app starts.
REMOTE_ACCESS=0

# --- AI providers ----------------------------------------------------------
# manus | anthropic | openai
AI_PROVIDER=manus
MANUS_API_KEY=
MANUS_AGENT_PROFILE=manus-1.6
# Anthropic and OpenAI also accept images, which the screenshot reply needs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Tracking --------------------------------------------------------------
TRACKING_PROVIDER=yuntrack
TRACKING_URL_TEMPLATE=https://www.yuntrack.com/parcelTracking?id={code}
# Raise an alert when a parcel has not moved in this many days.
TRACKING_STALE_DAYS=4
TRACKING_SYNC_MINUTES=180
# Optional paid fallback when YunTrack blocks automated requests.
SEVENTEENTRACK_KEY=

# --- Pricing ---------------------------------------------------------------
# The sale percentage shown next to every non-discount price.
DISCOUNT_PERCENT=30
