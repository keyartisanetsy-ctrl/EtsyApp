# ---------------------------------------------------------------------------
# Etsy Command Center - copy to .env and fill in.
# Everything here can also be set in the app's Settings screen, which stores
# secrets encrypted in the local database instead of in plain text.
# ---------------------------------------------------------------------------

# --- Etsy app credentials (etsy.com/developers/your-apps) ------------------
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
# Must match the callback URL registered on your Etsy app exactly. Use
# "localhost", not "127.0.0.1" -- Etsy's own app dashboard rejects an
# IP-literal callback URL ("IP addresses are not allowed"), so an IP here
# would leave a shop connection this app cannot actually register with Etsy.
# "localhost" also isn't tied to any one machine, so the same registered
# value keeps working if this app ever moves to a different computer or VDS.
ETSY_REDIRECT_URI=http://localhost:4317/api/auth/callback

# --- Server ----------------------------------------------------------------
PORT=4317
HOST=127.0.0.1
LOG_LEVEL=info
# Set a password only if you expose this beyond localhost.
APP_PASSWORD=
# Set to 1 to have "npm start" also open a temporary public link to this same
# running app, so it can be opened from another computer. APP_PASSWORD is
# generated automatically if left blank when this is on -- never expose the
# app without one. Pinggy is the default (no binary to download, and it
# reconnects itself automatically -- Pinggy's free tier closes the connection
# after about an hour on its own, but this notices and opens a fresh one with
# a new address right away, printed here again each time, for as long as this
# process keeps running -- no re-running anything by hand). Needs an "ssh"
# command on this machine, which Windows 10/11 already include.
# Set TUNNEL_PROVIDER=cloudflare to use a Cloudflare Tunnel instead (a small
# binary is downloaded once; its link also changes on every restart, but does
# not renew itself while the app keeps running).
REMOTE_ACCESS=0
TUNNEL_PROVIDER=pinggy
# On by default (both lines) -- the moment this starts, and every 30 minutes
# after, this computer's own copy checks this app's branch on GitHub and
# pulls in a newer commit, restarting itself to actually run it. No
# re-running anything by hand for every fix, on a VDS or on your own PC.
# This restart is safe because START-WINDOWS.bat / START-MAC-LINUX.command
# both loop and relaunch "npm start" the moment it exits (an NSSM/systemd
# service does the same on a VDS) -- every launch path this app ships
# handles it. Set either to 0 to opt out; set AUTO_UPDATE_RESTART=0
# specifically if you run "npm start" directly in a terminal without one of
# those wrapper scripts, since nothing there relaunches it for you.
AUTO_UPDATE=1
AUTO_UPDATE_RESTART=1

# --- AI providers ----------------------------------------------------------
# manus | anthropic | openai
AI_PROVIDER=manus
MANUS_API_KEY=
MANUS_AGENT_PROFILE=manus-1.6
# Anthropic and OpenAI also accept images, which the screenshot reply needs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Tracking --------------------------------------------------------------
TRACKING_PROVIDER=yuntrack
TRACKING_URL_TEMPLATE=https://www.yuntrack.com/parcelTracking?id={code}
# Raise an alert when a parcel has not moved in this many days.
TRACKING_STALE_DAYS=4
TRACKING_SYNC_MINUTES=180
# Optional paid fallback when YunTrack blocks automated requests.
SEVENTEENTRACK_KEY=

# --- Pricing ---------------------------------------------------------------
# The sale percentage shown next to every non-discount price.
DISCOUNT_PERCENT=30
